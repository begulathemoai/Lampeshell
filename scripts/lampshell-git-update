#!/usr/bin/env bash
# Runs at the end of arch-update / cachy-update. Pulls and rebuilds a git
# checkout of Lampshell, then restarts it. A packaged install has no checkout
# and exits immediately: pacman updates that itself.

set -uo pipefail

repo="${LAMP_SHELL_REPO:-$HOME/.config/quickshell/lampshell}"
script="$repo/scripts/lampshell"

[ -x "$script" ] || exit 0
[ -d "$repo/.git" ] || exit 0

before=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || exit 0

if ! "$script" update; then
    printf 'lampshell: update failed, leaving the shell as it was\n' >&2
    exit 0
fi

after=$(git -C "$repo" rev-parse HEAD 2>/dev/null)

if [ "$before" != "$after" ]; then
    printf 'lampshell: updated %s -> %s\n' "${before:0:7}" "${after:0:7}"
else
    printf 'lampshell: already up to date\n'
fi

exit 0
