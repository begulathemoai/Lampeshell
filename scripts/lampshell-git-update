#!/usr/bin/env bash

set -uo pipefail

repo="${LAMP_SHELL_REPO:-}"
if [ -z "$repo" ] && [ -r /etc/lampshell/repo ]; then
    repo=$(head -n 1 /etc/lampshell/repo)
fi
repo="${repo:-$HOME/.config/quickshell/lampshell}"
script="$repo/scripts/lampshell"

[ -x "$script" ] || exit 0
[ -d "$repo/.git" ] || exit 0

ensure_arch_update_hook() {
    local target="/usr/share/arch-update/lib/full_upgrade.sh"

    [ -f "$target" ] || return 0
    grep -Fq "lampshell-git-update" "$target" && return 0

    python3 - "$target" <<'PY' 2>/dev/null || return 0
import sys

target = sys.argv[1]
content = open(target).read()
anchor = content.rfind("quit_msg")
if anchor < 0:
    sys.exit(1)
hook = '\nif [ -x "/usr/local/bin/lampshell-git-update" ]; then\n\techo\n\t/usr/local/bin/lampshell-git-update\nfi\n\n'
open(target, "w").write(content[:anchor] + hook + content[anchor:])
PY

    echo "lampshell: re-added the arch-update hook" >&2
}

if [ "$(id -u)" -eq 0 ] && [ -z "${LAMPSHELL_UPDATER_USER:-}" ]; then
    ensure_arch_update_hook
    owner=$(stat -c '%U' "$repo" 2>/dev/null || true)
    home=$(getent passwd "$owner" 2>/dev/null | cut -d: -f6)
    if [ -n "$owner" ] && [ "$owner" != root ] && [ -n "$home" ] && command -v runuser >/dev/null 2>&1; then
        uid=$(id -u "$owner" 2>/dev/null || true)
        runtime="/run/user/$uid"
        exec runuser -u "$owner" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" LAMP_SHELL_REPO="$repo" LAMPSHELL_UPDATER_USER=1 "$0"
    fi
fi

ensure_arch_update_hook
"$script" update 2>&1 | tee /dev/stderr >/dev/null
exit 0
